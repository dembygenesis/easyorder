{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "prettier": "3.8.3",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
